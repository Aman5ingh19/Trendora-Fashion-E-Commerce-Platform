{
  "info": {
    "_postman_id": "trendora-ecommerce-api-collection",
    "name": "Trendora — Fashion E-Commerce API",
    "description": "Complete Postman collection for the Trendora Fashion E-Commerce REST API (MEAN Stack). Includes Auth, Products, Categories, Cart, Wishlist, Orders, and Admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aman Sharma\",\n  \"email\": \"aman@trendora.com\",\n  \"password\": \"Trendora2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@trendora.com\",\n  \"password\": \"Admin@Trendora2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Add Delivery Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aman Sharma\",\n  \"phone\": \"9876543210\",\n  \"pincode\": \"560001\",\n  \"street\": \"120 MG Road, Residency Area\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "addresses"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Products & Categories",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "Get Products (Paginated with Facets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?gender=Men&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "gender", "value": "Men" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=shirt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [{ "key": "search", "value": "shirt" }]
            }
          }
        },
        {
          "name": "Get Single Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{sampleProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{sampleProductId}}"]
            }
          }
        },
        {
          "name": "Get Related Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{sampleProductId}}/related",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{sampleProductId}}", "related"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart & Wishlist",
      "item": [
        {
          "name": "Get User Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart"]
            }
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{sampleProductId}}\",\n  \"size\": \"M\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items"]
            }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cart/items/{{sampleCartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "items", "{{sampleCartItemId}}"]
            }
          }
        },
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wishlist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist"]
            }
          }
        },
        {
          "name": "Toggle Item in Wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{sampleProductId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "items"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order (COD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Aman Sharma\",\n    \"phone\": \"9876543210\",\n    \"pincode\": \"560001\",\n    \"street\": \"120 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\"\n  },\n  \"paymentMethod\": \"COD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{sampleOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{sampleOrderId}}"]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my mind\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{sampleOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{sampleOrderId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"]
            }
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders?status=All&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders"],
              "query": [
                { "key": "status", "value": "All" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\",\n  \"comment\": \"Order confirmed by admin fulfillment desk\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders/{{sampleOrderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders", "{{sampleOrderId}}", "status"]
            }
          }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Linen Blend Mandarin Collar Shirt\",\n  \"brand\": \"TRENDORA MAN\",\n  \"category\": \"Clothing\",\n  \"gender\": \"Men\",\n  \"description\": \"Breathable premium linen blend shirt with mandarin collar.\",\n  \"price\": 1499,\n  \"originalPrice\": 2499,\n  \"images\": [\"https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=800&auto=format&fit=crop&q=80\"],\n  \"sizes\": [\n    { \"size\": \"S\", \"stock\": 10 },\n    { \"size\": \"M\", \"stock\": 15 },\n    { \"size\": \"L\", \"stock\": 8 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "sampleProductId", "value": "" },
    { "key": "sampleCartItemId", "value": "" },
    { "key": "sampleOrderId", "value": "" }
  ]
}
