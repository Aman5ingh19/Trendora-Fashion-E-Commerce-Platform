# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use MongoDB Atlas URI or local MongoDB: mongodb://127.0.0.1:27017/trendora_db
# If left empty in development, an in-memory MongoDB instance will automatically spin up!
MONGODB_URI=mongodb://127.0.0.1:27017/trendora_db

# JWT & Authentication Secrets
JWT_SECRET=trendora_super_secret_jwt_key_fashion_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=trendora_cookie_secret_key_random_hash

# Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:4200

# Initial Admin Credentials (used by scripts/seed.js)
ADMIN_NAME=Trendora Admin
ADMIN_EMAIL=admin@trendora.com
ADMIN_PASSWORD=Admin@Trendora2026!

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
