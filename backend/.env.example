# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Cloud Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.vbtvr4g.mongodb.net/trendora_db?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vbtvr4g.mongodb.net/trendora_db?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.vbtvr4g.mongodb.net/trendora_db?retryWrites=true&w=majority&appName=Cluster0
USE_MEMORY_DB_IF_LOCAL_FAILS=false

# JWT & Authentication Secrets (Set strong random strings in Render dashboard)
JWT_SECRET=trendora_super_secret_jwt_key_fashion_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=trendora_cookie_secret_key_random_hash

# Client URL (Set to your Vercel frontend URL, e.g. https://trendora-fashion.vercel.app)
CLIENT_URL=https://your-trendora-app.vercel.app

# Initial Admin Credentials (used by autoSeed & scripts/seed.js)
ADMIN_NAME=Trendora Admin
ADMIN_EMAIL=admin@trendora.com
ADMIN_PASSWORD=Admin@Trendora2026!
